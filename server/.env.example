# Copy this file to .env and fill in the real values. .env is git-ignored.

# Neon dashboard -> your project -> Connect -> copy the connection string
# Change "sslmode=require" at the end to "sslmode=verify-full" (same security, no warning).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# A long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The address people open in the browser (the frontend).
# Local: the Vite dev server.  Live: your Vercel URL, e.g. https://tamarind-and-tide.vercel.app
BETTER_AUTH_URL=http://localhost:5173

PORT=3000
