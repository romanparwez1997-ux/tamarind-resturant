# Copy this file to .env.local and fill in the real values. .env.local is git-ignored.

# Neon dashboard -> your project -> Connect -> copy the connection string
# Change "sslmode=require" at the end to "sslmode=verify-full" (same security, no warning).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# A long random string. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The address people open in the browser (the frontend).
# Local: the Next.js dev server.  Live: your Vercel URL, e.g. https://tamarind-and-tide.vercel.app
BETTER_AUTH_URL=http://localhost:3000

PORT=3000

# Stripe test/sandbox secret key, server-side only. Live keys are deliberately rejected.
STRIPE_SECRET_KEY=
# Optional: a publishable key alone cannot create server-side Checkout Sessions.
# The hosted redirect flow currently does not need this key in the browser.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally.
# On Vercel, use the signing secret for the deployed test webhook endpoint instead.
STRIPE_WEBHOOK_SECRET=

# Account verification emails. Use a sender on a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
